      "seed": 1129093245,
      "version": 1103,
      "versionNonce": 1613054067,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783788174523,
      "link": null,
      "locked": false,
      "text": "Real WhatsApp uses TLS connections, not using the\noverhead of WebSocket\n\nRESTFUL API doesn't make sense as a persistent\nconnection is required \nthat can ferry messages back and forth",
      "fontSize": 18.546837868349705,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Real WhatsApp uses TLS connections, not using the overhead of WebSocket\n\nRESTFUL API doesn't make sense as a persistent connection is required \nthat can ferry messages back and forth",
      "autoResize": false,
      "lineHeight": 1.25
