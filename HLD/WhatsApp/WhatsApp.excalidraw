      "versionNonce": 751221468,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784484186034,
      "link": null,
      "locked": false,
      "text": "Chat server generates the pre\nsigned URL and gives to the\nclient to upload media to the\nBLOB\n\nThen the receiver get the URL\nto download the media",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chat server generates the pre signed URL and gives to the client to upload media to the BLOB\n\nThen the receiver get the URL to download the media",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Sdl6d9aeQjibF0AHTce4y",
      "type": "text",
      "x": 3365.4166513275136,
      "y": 861.8137945191811,
      "width": 270.44915418216124,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 756543723,
      "version": 961,
      "versionNonce": 1919090524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784484186034,
      "link": null,
      "locked": false,
      "text": "Expire the media with a TTL\nwhen it is sent to the user,\nso that people don't use us as\na Google Drive",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expire the media with a TTL when it is sent to the user, so that people don't use us as a Google Drive",
      "autoResize": false,
      "lineHeight": 1.25
    },
