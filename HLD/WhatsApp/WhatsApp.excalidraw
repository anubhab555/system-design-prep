    {
      "id": "jFzhF-n7yYsXZAzCkB7t0",
      "type": "text",
      "x": 5103.003566610629,
      "y": 467.0640770948455,
      "width": 607.9650355529619,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1083065093,
      "version": 1536,
      "versionNonce": 112382940,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784482682218,
      "link": null,
      "locked": false,
      "text": "Using a Layer 4 load balancer hear instead of of a L7\n\nBecause we don't need any L7 capabilities for this service. L7 load\nbalancers shine when we want to, for instance, route traffic with\nspecific paths or headers to different services. They are application\nspecific or so to say content specific. L4 are simply faster here.\n\nThe LB here work on the basis of Chat Server with the least amount of\ntraffic",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Using a Layer 4 load balancer hear instead of of a L7\n\nBecause we don't need any L7 capabilities for this service. L7 load balancers shine when we want to, for instance, route traffic with specific paths or headers to different services. They are application specific or so to say content specific. L4 are simply faster here.\n\nThe LB here work on the basis of Chat Server with the least amount of traffic",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "eWUTiZybjxHDt7HSzbOlR",
      "type": "text",
      "x": 5802.435434183044,
      "y": 458.52717209685966,
      "width": 342.47792065013346,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 793396244,
      "version": 545,
      "versionNonce": 1231288412,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784482682218,
      "link": null,
      "locked": false,
      "text": "This now has broken the first\nrequirement of send messages through\nto users.\n\nWe have just naively scaled\nhorizontally, User A is connected to\nServer 1, User B is connected to\nServer 2. How do we know and deliver\nthe messages",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
