    {
      "id": "OzqeBlMUkzXtXS-_B-dN8",
      "type": "text",
      "x": 5217.615870473292,
      "y": 1745.9007620104067,
      "width": 79.19989013671875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
