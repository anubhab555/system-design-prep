    {
      "id": "bt497W1JoEOfqhv8Y_FZd",
      "type": "text",
      "x": 613.7033567066948,
      "y": 478.3059579630924,
      "width": 412.6232472306808,
      "height": 159.573331705729,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
