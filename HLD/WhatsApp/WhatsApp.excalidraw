      "type": "text",
      "x": 2935.32537518903,
      "y": 826.9777502350566,
      "width": 270.44915418216124,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
