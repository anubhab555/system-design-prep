    {
      "id": "DZoXlk0c2ySGZzWFJ1SHK",
      "type": "text",
      "x": 611.5188730981496,
      "y": 716.5802124737763,
      "width": 341,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
