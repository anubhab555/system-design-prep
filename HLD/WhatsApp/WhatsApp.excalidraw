    {
      "id": "lkQRWqKXOaTUWufhYpTX1",
      "type": "text",
      "x": 2918.0144904361405,
      "y": 1326.7926604210325,
      "width": 642.6272229672718,
      "height": 440,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 719014661,
      "version": 2919,
      "versionNonce": 1177084764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784484186034,
      "link": null,
      "locked": false,
      "text": "-> CLient says send messages to a given chatId here is the content\n-> Chat server will go and make a query to ChatParticipant table to know\nwho to send, will use the PK chatId\n-> Create a transaction to write to the Messages and Inbox channel\n-> Messages table will have only one record, the message and the content.\nThe Inbox will have records for each participant\n\nNote : Dynamo DB transactions support upto 100 records, make sure grp\nchats are no larger than 100 members\n\n-> Now we can go to the chat server to try and send the messages to the\nreceipients, now that we have the Inbox table ready. Chat server\nmaintains the Hashmap(Client, WS) and sends with the help of this map to\nthe clients it can actually.\n\n-> We need to maintain the ACK (Delivery Status). Once the client sends\nthe ACK the chat server can now delete that record from the Inbox table\n(to ensure delivery only once).\n\n-> When a client connects to the chat server after being offline, we need\nto look up in the Inbox table and deliver all the messages for the\nreceipientId and delete them all upon receiving the ACK.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> CLient says send messages to a given chatId here is the content\n-> Chat server will go and make a query to ChatParticipant table to know who to send, will use the PK chatId\n-> Create a transaction to write to the Messages and Inbox channel\n-> Messages table will have only one record, the message and the content. The Inbox will have records for each participant\n\nNote : Dynamo DB transactions support upto 100 records, make sure grp chats are no larger than 100 members\n\n-> Now we can go to the chat server to try and send the messages to the receipients, now that we have the Inbox table ready. Chat server maintains the Hashmap(Client, WS) and sends with the help of this map to the clients it can actually.\n\n-> We need to maintain the ACK (Delivery Status). Once the client sends the ACK the chat server can now delete that record from the Inbox table (to ensure delivery only once).\n\n-> When a client connects to the chat server after being offline, we need to look up in the Inbox table and deliver all the messages for the receipientId and delete them all upon receiving the ACK.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "lCGC8Z5f07iayf1O2V0GU",
      "type": "text",
      "x": 3624.471522601096,
      "y": 1223.1662075810964,
      "width": 334.1901376986672,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
      "roundness": null,
      "seed": 1436302149,
      "version": 868,
      "versionNonce": 1584142300,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784484186034,
      "link": null,
      "locked": false,
      "text": "\nGuranteeing eventual delivery after\nbeing offline and surely will receive\nif they are online.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nGuranteeing eventual delivery after being offline and surely will receive if they are online.",
      "autoResize": false,
      "lineHeight": 1.25
    },
