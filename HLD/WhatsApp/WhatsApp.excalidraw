    {
      "id": "aqo3hdFh3bCTnkmUvD8w9",
      "type": "arrow",
      "x": 5215.2711047554685,
      "y": 1862.3783784964853,
      "width": 28.3433176127337,
      "height": 61.45577644435707,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
