      "type": "text",
      "x": 2913.361003385434,
      "y": 1280.191675347815,
      "width": 44,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
