    {
      "id": "AwyTutHphCe1uJ4e6IHo3",
      "type": "text",
      "x": 2227.0169099372215,
      "y": 1098.7789946635603,
      "width": 486.6852097350487,
      "height": 139.1012840126228,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
